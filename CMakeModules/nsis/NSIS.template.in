;----------------------------------------
; based upon a script of "Written by KiCHiK 2003-01-18 05:57:02"
;----------------------------------------
!verbose 3
!include "WinMessages.NSH"
!verbose 4
;====================================================
; get_NT_environment
;     Returns: the selected environment
;     Output : head of the stack
;====================================================
!macro select_NT_profile UN
Function ${UN}select_NT_profile
   StrCmp $ADD_TO_PATH_ALL_USERS "1" 0 environment_single
      DetailPrint "Selected environment for all users"
      Push "all"
      Return
   environment_single:
      DetailPrint "Selected environment for current user only."
      Push "current"
      Return
FunctionEnd
!macroend
!insertmacro select_NT_profile ""
!insertmacro select_NT_profile "un."
;----------------------------------------------------
!define NT_current_env 'HKCU "Environment"'
!define NT_all_env     'HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"'

!ifndef WriteEnvStr_RegKey
  !ifdef ALL_USERS
    !define WriteEnvStr_RegKey \
       'HKLM "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"'
  !else
    !define WriteEnvStr_RegKey 'HKCU "Environment"'
  !endif
!endif

; NSIS strings stop at 1024 characters, which the PATH on a machine with CUDA,
; oneAPI and Visual Studio already exceeds. PowerShell edits the registry
; value instead, without expanding the variables in it. The script reads the
; directory from AF_PATH_DIR and the hive from AF_PATH_HIVE.
!define AF_PATH_PS_BEGIN "$$ErrorActionPreference='Stop';trap{exit 1};$$r=[Microsoft.Win32.Registry];$$k=if($$env:AF_PATH_HIVE -eq 'LocalMachine'){$$r::LocalMachine.OpenSubKey('SYSTEM\CurrentControlSet\Control\Session Manager\Environment',$$true)}else{$$r::CurrentUser.CreateSubKey('Environment')};$$p=[string]$$k.GetValue('Path','','DoNotExpandEnvironmentNames');$$l=$$p -split ';';$$d=$$env:AF_PATH_DIR;"

; RunPathScript - Runs a PATH script for the selected users
;        Input - head of the stack is the script, below it the directory
;        Output - head of the stack is the exit code, 0 on success
!macro RunPathScript un
Function ${un}RunPathScript
  Exch $0
  Exch
  Exch $1
  System::Call 'Kernel32::SetEnvironmentVariable(t "AF_PATH_DIR", t "$1")'
  StrCpy $1 "CurrentUser"
  StrCmp $ADD_TO_PATH_ALL_USERS "1" 0 +2
    StrCpy $1 "LocalMachine"
  System::Call 'Kernel32::SetEnvironmentVariable(t "AF_PATH_HIVE", t "$1")'
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$0"'
  Pop $0
  Pop $1
  Exch $0
FunctionEnd
!macroend
!insertmacro RunPathScript ""
!insertmacro RunPathScript "un."

; AddToPath - Adds the given dir to the search path.
;        Input - head of the stack

Function AddToPath
  Exch $0
  Push $1

  # don't add if the path doesn't exist
  IfFileExists "$0\*.*" "" AddToPath_done

  Push $0
  Push "${AF_PATH_PS_BEGIN}if(@($$l|?{$$_.TrimEnd('\') -eq $$d}).Count -eq 0){$$k.SetValue('Path',(($$p.TrimEnd(';'),$$d|?{$$_}) -join ';'),'ExpandString')}"
  Call RunPathScript
  Pop $1
  StrCmp $1 "0" AddToPath_notify
    MessageBox MB_OK|MB_ICONEXCLAMATION "Could not add $0 to PATH. Please add it manually." /SD IDOK
    Goto AddToPath_done
  AddToPath_notify:
    SendMessage ${HWND_BROADCAST} ${WM_WININICHANGE} 0 "STR:Environment" /TIMEOUT=5000

  AddToPath_done:
    Pop $1
    Pop $0
FunctionEnd


; RemoveFromPath - Remove a given dir from the path
;     Input: head of the stack

Function un.RemoveFromPath
  Exch $0
  Push $1

  Push $0
  Push "${AF_PATH_PS_BEGIN}$$n=@($$l|?{$$_.TrimEnd('\') -ne $$d});if($$n.Count -ne $$l.Count){$$k.SetValue('Path',($$n -join ';'),'ExpandString')}"
  Call un.RunPathScript
  Pop $1
  StrCmp $1 "0" 0 unRemoveFromPath_done
    SendMessage ${HWND_BROADCAST} ${WM_WININICHANGE} 0 "STR:Environment" /TIMEOUT=5000

  unRemoveFromPath_done:
    Pop $1
    Pop $0
FunctionEnd

Function ConditionalAddToRegisty
  Pop $0
  Pop $1
  StrCmp "$0" "" ConditionalAddToRegisty_EmptyString
    WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" \
    "$1" "$0"
    ;MessageBox MB_OK "Set Registry: '$1' to '$0'"
    DetailPrint "Set install registry entry: '$1' to '$0'"
  ConditionalAddToRegisty_EmptyString:
FunctionEnd

;--------------------------------

!ifdef CPACK_USES_DOWNLOAD
Function DownloadFile
    IfFileExists $INSTDIR\* +2
    CreateDirectory $INSTDIR
    Pop $0

    ; Skip if already downloaded
    IfFileExists $INSTDIR\$0 0 +2
    Return

    StrCpy $1 "@CPACK_DOWNLOAD_SITE@"

  try_again:
    NSISdl::download "$1/$0" "$INSTDIR\$0"

    Pop $1
    StrCmp $1 "success" success
    StrCmp $1 "Cancelled" cancel
    MessageBox MB_OK "Download failed: $1"
  cancel:
    Return
  success:
FunctionEnd
!endif

